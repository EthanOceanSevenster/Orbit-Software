# Copy to .env and adjust. Never commit .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Johannesburg

# Origins allowed to call the API (the Next.js frontend).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limit for public form submissions per IP.
API_FORM_THROTTLE=20/hour

# ---------------------------------------------------------------------------
# Email notifications
# ---------------------------------------------------------------------------
# Where new contact / project-request notifications are sent. Leave blank to disable.
NOTIFY_EMAIL=you@example.com

# Gmail SMTP. EMAIL_HOST_PASSWORD must be a Google App Password (16 characters),
# NOT your normal Gmail password. Create one at:
#   https://myaccount.google.com/apppasswords
# (2-Step Verification must be switched on for your Google account first.)
# While EMAIL_HOST_PASSWORD is blank, emails print to the console instead of sending.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Name recipients see in the From line of every email the site sends.
COMPANY_NAME=Orbit Software

# From address. Gmail requires this to match EMAIL_HOST_USER, so leave it
# blank and COMPANY_NAME is used as the display name automatically.
DEFAULT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Public identity (website + email signature)
# ---------------------------------------------------------------------------
# Shown publicly. Leave blank until a real company mailbox exists: a dead
# address is worse than none, and the contact form reaches you anyway.
# Must NOT contain a personal name. NOTIFY_EMAIL above is the private inbox.
PUBLIC_EMAIL=
COMPANY_WEBSITE=orbitsoftware.co.za
COMPANY_LOCATION=South Africa

# Comma-separated words the signature must never contain, such as a surname.
# Kept here, never in code, so the repository does not publish them.
SIGNATURE_FORBIDDEN_TERMS=

# ---------------------------------------------------------------------------
# Client portal and payments
# ---------------------------------------------------------------------------
# The website's public origin. Required in production: browser POSTs arrive
# through the website's proxy, so Django rejects them unless this is trusted.
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Where a customer returns to after paying. The website, not the API.
PORTAL_URL=http://localhost:3000

# Paystack. Blank means card payments are switched off and the portal says so.
# Test keys start sk_test_ / pk_test_. The secret key never reaches the browser.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# How many sign-in attempts one IP may make per hour.
API_LOGIN_THROTTLE=10/hour
